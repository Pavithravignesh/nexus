# MongoDB (local, no auth). Start it with `npm run db`.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=nexus

# Simulator: one tick for the whole fleet every TICK_MS; CHANGE_RATIO of devices report per tick.
TICK_MS=1000
CHANGE_RATIO=0.1
# Dirty readings and new events are flushed to MongoDB in one bulkWrite every FLUSH_INTERVAL_MS.
FLUSH_INTERVAL_MS=5000
# A reading older than STALE_AFTER_MS is stale; a device silent for OFFLINE_AFTER_MS is offline.
STALE_AFTER_MS=10000
OFFLINE_AFTER_MS=30000

# debug | info | warn | error
LOG_LEVEL=info
