      "text": "Side path: every 5 s the engine flushes dirty readings + new events to MongoDB via bulkWrite (never per tick, never row by row).",
      "originalText": "Side path: every 5 s the engine flushes dirty readings + new events to MongoDB via bulkWrite (never per tick, never row by row).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": true,
      "baseline": 15
    },
